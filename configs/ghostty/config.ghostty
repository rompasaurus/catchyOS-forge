command = /usr/bin/zsh

# ─── Appearance (Catppuccin Mocha + MesloLGS Nerd Font) ──────
# Font is installed by setup-zsh-theme.sh (ttf-meslo-nerd).
theme = "Catppuccin Mocha"
font-family = "MesloLGS Nerd Font"
font-size = 12
font-thicken = true

# Subtle transparency + blur (blur honored on KDE/Hyprland)
background-opacity = 0.92
background-blur = true

# Breathing room + cursor
window-padding-x = 14
window-padding-y = 10
window-padding-balance = true
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# Slimmer chrome
gtk-titlebar = false
unfocused-split-opacity = 0.85

# Tab switching with Ctrl+number
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Close split pane
keybind = ctrl+shift+w=close_surface

# Directional split navigation
keybind = ctrl+shift+[=goto_split:previous
keybind = ctrl+shift+]=goto_split:next
keybind = ctrl+shift+k=goto_split:top
keybind = ctrl+shift+j=goto_split:bottom
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
